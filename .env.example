# ===========================================================================
# TUSUR Schedule Telegram Bot & Pipeline Configuration
# ===========================================================================
# Copy this file to .env and fill in your values:
# cp .env.example .env

# ---------------------------------------------------------------------------
# 1. Telegram Bot (Required to start the bot)
# ---------------------------------------------------------------------------
# Get your token by messaging @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Telegram usernames of users authorized to edit schedule (without @, comma-separated)
ALLOWED_USERNAMES=nktatm

# ---------------------------------------------------------------------------
# 2. Gemini AI Analysis (Required for parsing teacher messages)
# ---------------------------------------------------------------------------
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# 3. Google Calendar Direct Sync (Optional)
# ---------------------------------------------------------------------------
# Google Calendar ID to sync with (e.g., your_calendar_id@group.calendar.google.com)
GOOGLE_CALENDAR_ID=
# Path to service account JSON file (or provide GOOGLE_CREDENTIALS_JSON inline)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# ---------------------------------------------------------------------------
# 4. GitHub Automatic Commit (Optional)
# ---------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained with Contents: write)
# to automatically commit overrides.json to the repository branch
GITHUB_TOKEN=
GITHUB_REPOSITORY=Lican1907/tusur-schedule
