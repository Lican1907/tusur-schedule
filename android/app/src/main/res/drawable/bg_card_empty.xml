<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow -->
    <item
        android:top="2dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#20000000" />
        </shape>
    </item>

    <!-- Frosted card body -->
    <item
        android:top="0dp"
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#40353C45" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
